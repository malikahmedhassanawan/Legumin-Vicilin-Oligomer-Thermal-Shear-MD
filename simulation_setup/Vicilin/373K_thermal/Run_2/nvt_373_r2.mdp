define = -DPOSRES
integrator = md
dt = 0.002
constraints = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
DispCorr = EnerPres
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau-t = 0.1 0.1
ref-t = 373 373
nsteps = 50000
continuation = no
pcoupl = no
gen-vel = yes
gen-temp = 373
gen-seed = 222
nstenergy = 500
nstlog = 500
nstxout-compressed = 5000
